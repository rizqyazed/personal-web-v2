---
import PocketBase from "pocketbase";

const pb = new PocketBase(import.meta.env.POCKETBASE_URL);
await pb.admins.authWithPassword(
  import.meta.env.POCKETBASE_EMAIL,
  import.meta.env.POCKETBASE_PASSWORD
);
const data = await pb.collection("works").getFullList();
const { title } = Astro.props;
---

<div>
  <a id="ran" href="">{title == null ? <slot /> : title}</a>
  <!-- <p id="blinking" style="display:none; color:text-blue-950">(click me!)</p> -->
</div>

<script define:vars={{ data }}>
  let previouslySelectedWorks = new Set();

  const buttons = document.querySelectorAll("#ran");
  const clickme = document.getElementById("blinking");

  // Handle clicks on each button.
  buttons.forEach((button) => {
    button.addEventListener("click", () => random());
  });

  let hidden = false;

  setInterval(blinking, 1000);

  function blinking() {
    if (!hidden) {
      clickme.style.display = "none";
      console.log("hide");
      hidden = true;
    } else {
      clickme.style.display = "inline-block";
      console.log("show");
      hidden = false;
    }
  }

  function random() {
    let randomWork;
    let attempts = 0;
    const maxAttempts = data.length * 2; // To avoid infinite loop

    do {
      const randomIndex = Math.floor(Math.random() * data.length);
      randomWork = data[randomIndex];
      attempts++;
      console.log(attempts);
    } while (
      previouslySelectedWorks.has(randomWork.id) &&
      attempts < maxAttempts
    );

    if (attempts >= maxAttempts) {
      previouslySelectedWorks.clear(); // Reset if all works have been selected
      previouslySelectedWorks.add(randomWork.id);
      console.warn("All works have been selected. Resetting.");
    }

    previouslySelectedWorks.add(randomWork.id);
    console.log(previouslySelectedWorks);
    console.log(randomWork.slug);

    document.getElementById("ran").href = `/${randomWork.slug}`;
    // return Response.redirect(new URL(`/${randomWork.slug}`, context.url), 302);
  }
</script>
