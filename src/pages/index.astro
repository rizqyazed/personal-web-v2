---
import { Image } from "astro:assets";
import Random from "../components/Random.astro";
import image from "../assets/landing_bg.jpeg";
---

<div class="everything">
  <Random>
    <Image
      alt="landing"
      onload="this.width=imgwidth;this.height=imgheight;"
      class="landing"
      src={image}
    />
  </Random>
  
