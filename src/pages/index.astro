---
import { Image } from "astro:assets";
import Random from "../components/Random.astro";
import image from "../assets/landing_bg.jpeg";
---

<div class="everything">
  <Random>
    <Image
      alt="landing"
      onload="this.width=imgwidth;this.height=imgheight;"
      class="landing"
      src={image}
    />
  </Random>
</div>

<style>
  .landing {
    width: 100%;
    height: 100vh;
    object-fit: cover;
  }
  html, body {
    margin: 0;
  }
</style>

 <script src="https://mewes-space.xyz/webring/pigeon-webring.js" defer></script>
