---
import Random from "../components/Random.astro"
import Layout from "../layouts/Layout.astro";
import { Vimeo } from "astro-embed";
import PocketBase from "pocketbase";
import { Image } from "astro:assets";
// const { slug } = Astro.params;


export async function getStaticPaths() {
    const pb = new PocketBase(import.meta.env.POCKETBASE_URL);
    await pb.admins.authWithPassword(
        import.meta.env.POCKETBASE_EMAIL,
        import.meta.env.POCKETBASE_PASSWORD
    );
    const data = await pb.collection("works").getFullList();
    pb.authStore.clear();
    return data.map((post: any) => {
        return {
            params: { slug: post.slug },
            props: { post },
        };
    });
}

const { post } = Astro.props;
---

<Layout>
  <div>
    <Random class="my-9" title={post.title}/>
    {
      post.media.map((image: any) => (
        <Image
          src={`${import.meta.env.POCKETBASE_URL}/api/files/works/${post.id}/${image}`}
          alt={post.title}
          class="w-lg md:w-md my-4"
          inferSize
        />
      ))
    }
    {post.video != "" && <Vimeo class="w-md my-4" id={post.video} />}
    <Fragment set:html={post.desc} />
  </div>
</Layout>
