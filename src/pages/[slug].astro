---
export const prerender = true
import Layout from "../layouts/Layout.astro";
import { Vimeo } from "astro-embed";
import PocketBase from "pocketbase";
const { slug } = Astro.params;

const pb = new PocketBase(import.meta.env.POCKETBASE_URL);
await pb.admins.authWithPassword(
  import.meta.env.POCKETBASE_EMAIL,
  import.meta.env.POCKETBASE_PASSWORD
);

export async function getStaticPaths() {
  const posts = await pb.collection("works").getFullList();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const post = await pb.collection("works").getFirstListItem(`slug="${slug}"`);

